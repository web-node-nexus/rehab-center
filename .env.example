# Server
PORT=4000
NODE_ENV=development
HOST=http://localhost:4000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rehab_center
DB_USER=root
DB_PASSWORD=your_mysql_password

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
